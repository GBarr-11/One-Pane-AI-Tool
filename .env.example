# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# Nothing here is required to run the offline demo; every setting degrades
# safely when unset.

# ---------------------------------------------------------------------------
# Generation provider
# ---------------------------------------------------------------------------

# mock (default, offline, no key) | claude
ONEPANE_PROVIDER=mock

# Only needed when ONEPANE_PROVIDER=claude.
# ANTHROPIC_API_KEY=

# When the internal Expedient AI gateway is approved, it goes here instead and
# the claude provider is pointed at it. Same request shape, different host.
# ONEPANE_AI_BASE_URL=

# ---------------------------------------------------------------------------
# SMC API  <-- THE API KEY GOES HERE
#
# Per the SMC API Functions doc, apiv2 uses HTTP Basic auth: a username (the
# doc's examples default to 'OSC') and the API key as the password. Put the key
# in SMC_API_PASS - it is read from the environment and never appears in code,
# in the panel, or in anything the extension sends.
#
# READ-ONLY. One Pane issues GET only. It never calls POST /Note - which is the
# endpoint that posts a reply to a ticket - and never PUT /Ticket/{id}. The
# analyst posts from the SMC UI themselves. Ask for a read-scoped credential so
# that is enforced on the server side too, not just by our own restraint.
# ---------------------------------------------------------------------------

# SMC_API_BASE_URL=https://apiv2.expedient.com
# SMC_API_USER=OSC
# SMC_API_PASS=

# ---------------------------------------------------------------------------
# Source links
#
# When set, every cited techdoc and ticket in the panel becomes a real link.
# When unset the citation still shows, just without a hyperlink. This is the
# SMC web console, not the API host.
# ---------------------------------------------------------------------------

# SMC_BASE_URL=https://app.expedient.com
# ONEPANE_KB_BASE_URL=https://kb.expedient.com/techdocs
