# Copy to .env and fill in. .env is gitignored - never commit real values.
#
# Production (npm start) needs at least ONEPANE_PROVIDER and its key to draft;
# with it unset, drafting is refused rather than faked. The Control Center at
# http://localhost:3000 shows which of these are set (never their values).
#
# The offline demo needs none of this: npm run mock:offline.

# ---------------------------------------------------------------------------
# Whose keys get spent
#
# server (default): the secrets below are used for every caller that does not
#   send its own. Right for one developer on their own machine.
# per-user: the server holds no keys. Each analyst puts their own Open WebUI
#   key, SMC token, and Confluence token in the extension's settings, and the
#   extension sends them with each request. Secrets set below are IGNORED
#   (the Control Center marks them so). Use this for any server someone else
#   can reach - it must then be served over HTTPS.
# Anything else is refused at startup rather than guessed at.
# ---------------------------------------------------------------------------

# ONEPANE_CREDENTIALS=server

# per-user only: let analysts who have not added their own Confluence token
# search with CONFLUENCE_EMAIL / CONFLUENCE_API_TOKEN below. Every analyst then
# sees what that account sees, so it must be a service account limited to the
# SOP spaces - never a person's own token.
# CONFLUENCE_SHARED_ACCOUNT=true

# ---------------------------------------------------------------------------
# Generation provider
# ---------------------------------------------------------------------------

# openwebui | claude. No default: unset means no provider. The offline 'mock'
# provider exists only inside onepane-mock (npm run mock).
ONEPANE_PROVIDER=

# Model ID override. openwebui defaults to gpt-5.6-luna, claude to
# claude-opus-5. List gateway IDs with GET {OWUI_URL}/models.
# ONEPANE_MODEL=

# Only needed when ONEPANE_PROVIDER=openwebui. Expedient's Open WebUI gateway,
# OpenAI-compatible. OWUI_URL is the host plus /api, no trailing slash. The key
# is read by the server only - it never reaches the extension or the panel.
# OWUI_URL=https://<your-open-webui-host>/api
# OWUI_API_KEY=

# Only needed when ONEPANE_PROVIDER=claude (direct Anthropic API).
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# SMC API  <-- THE API KEY GOES HERE
#
# Uncomment the three lines below (remove the leading '#') and put the key in
# SMC_API_PASS. It is read from the environment and never appears in code, in
# the panel, or in anything the extension sends.
#
# AUTH SCHEME FOLLOWS SMC_API_USER:
#   empty -> Bearer <token>   <-- what v3 uses (spec declares `bearerAuth`)
#   set   -> HTTP Basic (user:key), which is what the older apiv2 doc describes
# Leave SMC_API_USER present but EMPTY for v3.
#
# v3 tokens are short-lived (~4h) and are issued per-person by IS-AUTH, so a
# pasted token is a test credential, not a deployment story. See README.
#
# BASE URL confirmed 2026-09-15 against the spec's own `servers` block:
#   production  https://api.expedient.com/v3
#   stage       https://stage-api.expedient.com/v3
# No trailing slash.
#
# READ-ONLY. One Pane issues GET only - server/smc/client.js hardcodes the
# method and exports no write function. It never calls POST /Note, which is the
# endpoint that posts a reply to a ticket, and never PUT /Ticket/{id}. The
# analyst posts from the SMC UI themselves. Ask for a read-scoped credential so
# that is enforced on the server side too, not just by our own restraint.
# ---------------------------------------------------------------------------

# SMC_API_BASE_URL=https://api.expedient.com/v3
# SMC_API_USER=OSC
# SMC_API_PASS=

# Stage is the right target for prototype work; production is the default only
# because that is where the token audience points. Swap the base URL above.
#   https://stage-api.expedient.com/v3

# ---------------------------------------------------------------------------
# Confluence knowledge base  <-- THE ATLASSIAN API TOKEN GOES HERE
#
# When these three are set, drafts are grounded in real SOPs/techdocs searched
# live from Confluence. Production has no other techdoc source. Read-only: the client in
# server/confluence/client.js issues GET only.
#
# Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
# (see README "Confluence knowledge base"). The token reads everything its
# account can read, and every analyst using One Pane sees what it sees - use a
# service account limited to the SOP spaces if you can get one.
#
# CONFLUENCE_SITE_URL is the site root, no /wiki and no trailing slash.
# ---------------------------------------------------------------------------

# CONFLUENCE_SITE_URL=https://expedient-cloud.atlassian.net
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=

# Only for a SCOPED token (the "Create API token with scopes" button). Leave
# unset for a classic token. Find it at
# https://expedient-cloud.atlassian.net/_edge/tenant_info  -> "cloudId"
# CONFLUENCE_CLOUD_ID=

# Strongly recommended: limit search to the spaces that hold SOPs, by space
# key (the SOC in /wiki/spaces/SOC/...). Comma-separated. Unset = every space
# the token can see, which includes meeting notes and personal spaces.
# CONFLUENCE_SPACES=

# Optional: only pages carrying one of these labels. Comma-separated.
# CONFLUENCE_LABELS=

# auto (default) = Confluence when configured, else none | confluence.
# 'mock' works only inside onepane-mock, which also makes it auto's fallback.
# ONEPANE_KB_SOURCE=auto

# ---------------------------------------------------------------------------
# Source links
#
# When set, every cited techdoc and ticket in the panel becomes a real link.
# When unset the citation still shows, just without a hyperlink. This is the
# SMC web console, not the API host.
# ---------------------------------------------------------------------------

# SMC_BASE_URL=https://app.expedient.com
# ONEPANE_KB_BASE_URL=https://kb.expedient.com/techdocs

# ---------------------------------------------------------------------------
# Server
#
# Keep HOST on loopback. The server has no authentication, and with a real
# provider /api/generate spends the gateway key for whoever can reach it.
# ---------------------------------------------------------------------------

# HOST=127.0.0.1
# PORT=3000
